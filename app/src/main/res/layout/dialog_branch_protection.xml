<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_x_large"
        android:paddingEnd="@dimen/spacing_x_large"
        android:paddingTop="@dimen/spacing_small">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/protect_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/protection_enabled"
            android:textSize="@dimen/text_normal"/>

        <LinearLayout
            android:id="@+id/protection_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/require_pr_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_require_pr"/>

            <LinearLayout
                android:id="@+id/pr_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="32dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/protection_approvals">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/approvals_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <CheckBox
                    android:id="@+id/dismiss_stale_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_dismiss_stale"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/conversation_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_conversation"/>
            <CheckBox
                android:id="@+id/linear_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_linear"/>
            <CheckBox
                android:id="@+id/force_push_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_force_push"/>
            <CheckBox
                android:id="@+id/deletions_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_deletions"/>
            <CheckBox
                android:id="@+id/enforce_admins_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_enforce_admins"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
