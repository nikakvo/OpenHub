<?xml version="1.0" encoding="utf-8"?>
<!-- The About easter egg: rain over the whole screen. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/egg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.thirtydegreesray.openhub.ui.widget.MatrixRainView
        android:id="@+id/egg_rain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:background="@drawable/egg_panel">

        <com.thirtydegreesray.openhub.ui.widget.MatrixWelcomeView
            android:id="@+id/egg_title"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#CFFFDD"
            android:text="@string/about_egg_text"/>

        <TextView
            android:id="@+id/egg_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:background="@drawable/about_version_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#39FF7A"
            android:text="@string/about_egg_exit"/>
    </LinearLayout>
</FrameLayout>
