<?xml version="1.0" encoding="utf-8"?>
<!-- Create or edit a repository ruleset (RulesetEditActivity). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_appbar"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_normal"
                android:paddingBottom="@dimen/spacing_large">

                <TextView
                    android:id="@+id/readonly_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_mini"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone"
                    android:textSize="@dimen/text_small"
                    android:textColor="?android:textColorSecondary"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/ruleset_name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/FormSectionTitle"
                    android:text="@string/ruleset_enforcement"/>
                <RadioGroup
                    android:id="@+id/enforcement_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/enforcement_active"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ruleset_active"/>
                    <RadioButton
                        android:id="@+id/enforcement_disabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ruleset_disabled"/>
                    <RadioButton
                        android:id="@+id/enforcement_evaluate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/ruleset_evaluate"/>
                </RadioGroup>
                <TextView
                    android:id="@+id/targets_title"
                    style="@style/FormSectionTitle"
                    android:text="@string/ruleset_targets"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/ruleset_include">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/include_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:id="@+id/target_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/add_default_bn"
                        style="@style/OpenHubButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ruleset_add_default"/>
                    <Button
                        android:id="@+id/add_all_bn"
                        style="@style/OpenHubButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/ruleset_add_all"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/ruleset_exclude">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/exclude_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/targets_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_mini"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="@string/ruleset_targets_note"
                    android:textSize="@dimen/text_small"
                    android:textColor="?android:textColorSecondary"/>
                <TextView
                    style="@style/FormSectionTitle"
                    android:text="@string/ruleset_bypass"/>
                <CheckBox
                    android:id="@+id/bypass_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_bypass_admins"/>
                <RadioGroup
                    android:id="@+id/bypass_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/bypass_always"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ruleset_bypass_always"/>
                    <RadioButton
                        android:id="@+id/bypass_pull_request"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ruleset_bypass_pull_request"/>
                </RadioGroup>
                <TextView
                    android:id="@+id/bypass_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_mini"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone"
                    android:textSize="@dimen/text_small"
                    android:textColor="?android:textColorSecondary"/>
                <TextView
                    style="@style/FormSectionTitle"
                    android:text="@string/ruleset_rules"/>
                <CheckBox
                    android:id="@+id/creation_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_creation"/>
                <CheckBox
                    android:id="@+id/update_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_update"/>
                <CheckBox
                    android:id="@+id/deletion_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_deletion"/>
                <CheckBox
                    android:id="@+id/linear_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_linear"/>
                <CheckBox
                    android:id="@+id/signatures_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_signatures"/>
                <CheckBox
                    android:id="@+id/pull_request_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_pull_request"/>
                <LinearLayout
                    android:id="@+id/pull_request_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/ruleset_approvals">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/approvals_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <CheckBox
                    android:id="@+id/dismiss_stale_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_dismiss_stale"/>
                <CheckBox
                    android:id="@+id/code_owner_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_code_owner"/>
                <CheckBox
                    android:id="@+id/last_push_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_last_push"/>
                <CheckBox
                    android:id="@+id/thread_resolution_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_thread_resolution"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginStart="@dimen/spacing_mini"
                    android:text="@string/ruleset_merge_methods"
                    android:textSize="@dimen/text_small"
                    android:textColor="?android:textColorSecondary"/>
                <CheckBox
                    android:id="@+id/method_merge_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_method_merge"/>
                <CheckBox
                    android:id="@+id/method_squash_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_method_squash"/>
                <CheckBox
                    android:id="@+id/method_rebase_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_method_rebase"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/status_checks_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_status_checks"/>
                <LinearLayout
                    android:id="@+id/status_checks_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/ruleset_checks">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/checks_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <CheckBox
                    android:id="@+id/strict_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_strict"/>
                </LinearLayout>
                <CheckBox
                    android:id="@+id/force_push_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ruleset_rule_force_push"/>
                <TextView
                    android:id="@+id/other_rules_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_mini"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:visibility="gone"
                    android:textSize="@dimen/text_small"
                    android:textColor="?android:textColorSecondary"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/loader"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"/>
    </FrameLayout>

    <View
        android:id="@+id/save_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:listDivider"/>

    <LinearLayout
        android:id="@+id/save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small">
        <Button
            android:id="@+id/save_bn"
            style="@style/OpenHubButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"/>
    </LinearLayout>

</LinearLayout>
