<?xml version="1.0" encoding="utf-8"?>
<!-- Markdown text with Write / Preview tabs, like the editors on github.com.
     Driven by ui/widget/MarkdownWritePreview. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/md_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/md_tab_write"
            style="@style/MarkdownTab"
            android:text="@string/write"/>
        <TextView
            android:id="@+id/md_tab_preview"
            style="@style/MarkdownTab"
            android:text="@string/preview"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.thirtydegreesray.openhub.ui.widget.ToastAbleImageButton
            android:id="@+id/md_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="@dimen/spacing_small"
            app:srcCompat="@drawable/ic_select_all"
            android:tint="?android:textColorSecondary"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/write_select_all"
            app:toast_text="@string/write_select_all"
            android:visibility="gone"/>
        <com.thirtydegreesray.openhub.ui.widget.ToastAbleImageButton
            android:id="@+id/md_attach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="@dimen/spacing_small"
            app:srcCompat="@drawable/ic_attach_file"
            android:tint="?android:textColorSecondary"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach_file"
            app:toast_text="@string/attach_file"
            android:visibility="gone"/>
    </LinearLayout>

    <View
        android:id="@+id/md_tabs_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:listDivider"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/md_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_mini">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/md_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:minLines="6"/>
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:id="@+id/md_preview_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="160dp"
        android:visibility="gone">
        <com.thirtydegreesray.openhub.ui.widget.webview.CodeWebView
            android:id="@+id/md_preview_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:webview_background="?android:windowBackground"/>
        <TextView
            android:id="@+id/md_preview_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_large"
            android:gravity="center"
            android:text="@string/nothing_to_preview"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone"/>
        <ProgressBar
            android:id="@+id/md_preview_loader"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
