<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_x_large"
        android:paddingEnd="@dimen/spacing_x_large"
        android:paddingTop="@dimen/spacing_small">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/message_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/commit_message">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/commit_description">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/description_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="6"/>
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/target_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal">
            <RadioButton
                android:id="@+id/target_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/target_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/commit_to_new_branch"/>
        </RadioGroup>

        <CheckBox
            android:id="@+id/pull_current_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/new_branch_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="32dp"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/branch_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/commit_branch_name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/branch_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <CheckBox
                android:id="@+id/pull_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/commit_open_pull"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
