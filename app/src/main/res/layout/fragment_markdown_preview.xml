<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- the text as GitHub renders it, like the Preview tab of the comment boxes -->
    <com.thirtydegreesray.openhub.ui.widget.webview.CodeWebView
        android:id="@+id/preview_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:webview_background="?android:windowBackground"/>

    <TextView
        android:id="@+id/preview_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_large"
        android:gravity="center"
        android:text="@string/nothing_to_preview"
        android:textSize="@dimen/text_normal"
        android:textColor="?android:textColorSecondary"/>

    <ProgressBar
        android:id="@+id/preview_loader"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone"/>

</FrameLayout>
