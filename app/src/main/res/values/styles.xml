<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="DividerLine">
        <item name="android:background">@color/material_grey_700</item>
    </style>

    <style name="DividerLine.Horizontal" parent="DividerLine">
        <item name="android:layout_height">@dimen/divider_width</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="DividerLine.Vertical" parent="DividerLine">
        <item name="android:layout_width">@dimen/divider_width</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Keep the classic layout on Android 15+ until the UI handles insets itself. -->
        <item name="android:statusBarColor">@color/transparent</item>
        <!--<item name="android:windowLightStatusBar" tools:targetApi="m">true</item>-->
        <item name="android:windowBackground">@drawable/splash_screen_drawable</item>
        <!--<item name="icon_color">@color/white</item> &lt;!&ndash; to display the icons properly since this theme is the default &ndash;&gt;-->
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">?title_color</item>
    </style>

    <style name="Toolbar.Subtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">@dimen/text_mini</item>
        <item name="android:textColor">?subtitle_color</item>
    </style>

    <style name="Toolbar.Expand.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="text_link">
        <item name="android:textColor">?android:colorAccent</item>
    </style>

    <style name="label_color">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?title_color</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Draft / Pre-release / Latest marker of a release -->
    <style name="ReleaseBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/spacing_small</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textSize">@dimen/text_mini</item>
        <item name="android:textColor">?colorAccent</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Forms (new repository, release editor) -->
    <style name="FormSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_large</item>
        <item name="android:layout_marginStart">@dimen/spacing_mini</item>
        <item name="android:layout_marginBottom">@dimen/spacing_mini</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>

    <style name="FormChoiceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">@dimen/spacing_mini</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="FormChoiceValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_small</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">?colorAccent</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Write / Preview tabs of Markdown editors -->
    <style name="MarkdownTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/spacing_normal</item>
        <item name="android:paddingBottom">@dimen/spacing_normal</item>
        <item name="android:paddingStart">@dimen/spacing_large</item>
        <item name="android:paddingEnd">@dimen/spacing_large</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">?android:textColorSecondary</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The side menu on other screens slides in from the left (MainMenuDrawer). -->
    <style name="MainMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/main_menu_in</item>
        <item name="android:windowExitAnimation">@anim/main_menu_out</item>
    </style>


    <!-- Modern buttons: rounded pills, sentence case, sink a little while pressed. -->
    <style name="OpenHubButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/btn_filled_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@animator/btn_press</item>
    </style>

    <!-- Secondary actions: accent-tinted pill with a thin outline. -->
    <style name="OpenHubButton.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/btn_accent_text</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Dialog and other text actions: accent text, rounded ripple. -->
    <style name="OpenHubButton.Text">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/btn_accent_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

</resources>
