<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 backups. Accounts (database with the encrypted GitHub tokens, which
     cannot be opened on another phone anyway) and a running sign-in are never backed up;
     settings are. -->
<full-backup-content>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="oauth_session.xml"/>
</full-backup-content>
