    </domain-config>
    <!-- Debug builds only: a developer may look at the app's own traffic with a proxy -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user" overridePins="true"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
