<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and phone-to-phone transfer: the same rules as
     backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="oauth_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="oauth_session.xml"/>
    </device-transfer>
</data-extraction-rules>
