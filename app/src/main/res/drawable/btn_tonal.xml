<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action: a soft accent-tinted pill with a thin outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_ripple_accent">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="@color/btn_tonal_fill"/>
            <stroke android:width="1dp" android:color="@color/btn_tonal_stroke"/>
        </shape>
    </item>
</ripple>
